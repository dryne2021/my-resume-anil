# Copy to .env for local dev. On Vercel: Project → Settings → Environment Variables.
OPENAI_API_KEY="sk-..."
OWNER_EMAIL="dryne2021@gmail.com"
OWNER_PASSWORD="choose-a-strong-password"
# Any long random string; signs the login cookie. Changing it logs you out everywhere.
SESSION_SECRET="paste-a-long-random-string-here"
# Optional: OpenAI model to use (default gpt-4.1-mini).
# OPENAI_MODEL="gpt-4.1-mini"
# Optional: "priority" (default, faster, costs more) or "default".
# OPENAI_SERVICE_TIER="priority"
